diff --git a/local_bootstrap.py b/local_bootstrap.py
new file mode 100644
index 0000000..fc98a3c
--- /dev/null
+++ b/local_bootstrap.py
@@ -0,0 +1,283 @@
+r"""
+local_bootstrap.py — create an empty local Postgres schema for development.
+
+The Space gets its schema from bootstrap_db.py, which clones the team's live
+database. That needs credentials for the shared RDS instance, which is exactly
+what a laptop should not have. This script builds the same empty schema from
+scratch instead, so a developer can run the whole agent against their own
+Postgres with nothing shared.
+
+What it creates (all IF NOT EXISTS — safe to re-run):
+  1. the target database itself, if missing (UTF8, from template0)
+  2. Polymers / Fibers / Composites_materials with the legacy columns the
+     Space's data_loader.py SELECTs
+  3. every hardening column, the dedup indexes and the `sources` table, by
+     calling pg_mirror.ensure_schema() — the same code path pg_migrate.py uses
+  4. the agent_* bookkeeping tables, via agent.agdb.ensure_agent_schema()
+
+Safety: this script refuses to write to anything but a local server, and it
+decides that by asking the server where it actually is (inet_server_addr())
+rather than by trusting the hostname you typed. A tunnel on localhost:5433, a
+/etc/hosts entry, or a DATABASE_URL pointing at RDS are all caught. --force
+overrides, and says loudly what it is overriding.
+
+Usage:
+    python local_bootstrap.py            # uses .env / environment
+    python local_bootstrap.py --check    # report only, change nothing
+"""
+
+from __future__ import annotations
+
+import argparse
+import ipaddress
+import os
+import sys
+
+try:
+    import envfile
+    envfile.load_env_file()
+except ImportError:  # pragma: no cover
+    envfile = None
+
+import psycopg
+from psycopg import sql
+
+import pg_mirror
+
+BASE_TABLES = ("Polymers", "Fibers", "Composites_materials")
+
+BASE_DDL = """
+CREATE TABLE IF NOT EXISTS {table} (
+    id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
+    material_name text,
+    material_abbreviation text,
+    section text,
+    property_name text,
+    value text,
+    unit text,
+    english text,
+    test_condition text,
+    comments text
+)
+"""
+
+
+def _cfg() -> dict[str, str]:
+    """Connection settings, from DATABASE_URL when set, else the DB_* vars.
+
+    DATABASE_URL must win here because it wins in pg_mirror.connect_from_env():
+    if this script planned against DB_* while agdb wrote through DATABASE_URL,
+    the safety check and the writes would be looking at different servers.
+    """
+    url = os.environ.get("DATABASE_URL", "").strip()
+    if url:
+        try:
+            parsed = psycopg.conninfo.conninfo_to_dict(url)
+        except psycopg.Error as exc:
+            raise SystemExit(f"DATABASE_URL is set but cannot be parsed: {exc}")
+        return {
+            "host": parsed.get("host", "") or "",
+            "port": str(parsed.get("port", "") or "5432"),
+            "dbname": parsed.get("dbname", "") or "",
+            "user": parsed.get("user", "") or "",
+            "password": parsed.get("password", "") or "",
+            "sslmode": parsed.get("sslmode") or os.environ.get("DB_SSLMODE", "prefer"),
+            "source": "DATABASE_URL",
+        }
+    return {
+        "host": os.environ.get("DB_HOST", ""),
+        "port": os.environ.get("DB_PORT", "5432"),
+        "dbname": os.environ.get("DB_NAME", ""),
+        "user": os.environ.get("DB_USER", ""),
+        "password": os.environ.get("DB_PASSWORD", ""),
+        # pg_mirror defaults to "require"; a local server almost never has SSL,
+        # so default to "prefer" here but let DB_SSLMODE win if it is set.
+        "sslmode": os.environ.get("DB_SSLMODE", "prefer"),
+        "source": "DB_* variables",
+    }
+
+
+def _connect(cfg: dict[str, str], dbname: str) -> psycopg.Connection:
+    return psycopg.connect(host=cfg["host"] or None, port=int(cfg["port"] or 5432),
+                           dbname=dbname, user=cfg["user"] or None,
+                           password=cfg["password"] or None,
+                           sslmode=cfg["sslmode"], connect_timeout=15)
+
+
+def server_is_local(conn: psycopg.Connection) -> tuple[bool, str]:
+    """Ask the server where it is. Returns (is_local, human description).
+
+    inet_server_addr() is NULL over a unix socket (necessarily local) and
+    otherwise gives the address the server accepted the connection on — which
+    a hostname check cannot fake and an SSH tunnel cannot hide.
+    """
+    with conn.cursor() as cur:
+        # host() strips the netmask: inet_server_addr() is an `inet`, and
+        # casting it to text can yield "127.0.0.1/32", which ip_address()
+        # rejects — that would fail closed on every legitimate local run.
+        cur.execute("SELECT host(inet_server_addr()), inet_server_port()")
+        addr, port = cur.fetchone()
+    if addr is None:
+        return True, "unix socket (local)"
+    try:
+        ip = ipaddress.ip_address(addr)
+    except ValueError:
+        return False, f"{addr}:{port} (unrecognised address)"
+    return ip.is_loopback, f"{addr}:{port}"
+
+
+def ensure_database(cfg: dict[str, str], name: str, force: bool = False) -> bool:
+    """CREATE DATABASE if absent. Returns True if it created one."""
+    conn = _connect(cfg, "postgres")
+    try:
+        # autocommit first: CREATE DATABASE cannot run inside a transaction,
+        # and psycopg refuses to flip the flag once a query has opened one.
+        conn.autocommit = True
+        ok, where = server_is_local(conn)
+        if not ok and not force:
+            raise SystemExit(
+                f"refusing to CREATE DATABASE on {where}: that is not this machine."
+            )
+        if not ok:
+            print(f"  !! --force: creating a database on a NON-LOCAL server at {where}")
+        with conn.cursor() as cur:
+            cur.execute("SELECT 1 FROM pg_database WHERE datname = %s", (name,))
+            if cur.fetchone():
+                return False
+            # template0 + explicit UTF8: inheriting a SQL_ASCII template1 makes
+            # psycopg return column names as bytes, and the schema check then
+            # fails against a database that is actually fine.
+            cur.execute(sql.SQL("CREATE DATABASE {} ENCODING 'UTF8' TEMPLATE template0")
+                        .format(sql.Identifier(name)))
+            return True
+    finally:
+        conn.close()
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__,
+                                 formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--check", action="store_true",
+                    help="report what exists; make no changes")
+    ap.add_argument("--force", action="store_true",
+                    help="allow a non-local server (you almost never want this)")
+    args = ap.parse_args()
+
+    cfg = _cfg()
+    gaps = [k for k, v in (("host/DB_HOST", cfg["host"]),
+                           ("dbname/DB_NAME", cfg["dbname"]),
+                           ("user/DB_USER", cfg["user"])) if not v]
+    if gaps:
+        print(f"Incomplete connection settings (from {cfg['source']}): missing "
+              + ", ".join(gaps)
+              + ".\nCopy .env.example to .env and fill it in, then run "
+                "`python envfile.py` to check.", file=sys.stderr)
+        return 2
+
+    print(f"Target: {cfg['user']}@{cfg['host'] or 'local socket'}:{cfg['port']}"
+          f"/{cfg['dbname']}  (from {cfg['source']})")
+
+    # --- connect, then verify the server really is this machine -------------
+    try:
+        conn = _connect(cfg, cfg["dbname"])
+    except psycopg.OperationalError as exc:
+        text = str(exc)
+        first = text.strip().splitlines()[-1]
+        if "does not exist" in text and args.check:
+            print(f"  cannot connect: {first}")
+            print("  -> run `python local_bootstrap.py` (no --check) to create it")
+            return 1
+        if "does not exist" in text:
+            # Expected on a first run — creating it is this script's whole job.
+            print(f"  database {cfg['dbname']}: does not exist yet")
+        elif "Connection refused" in text or "could not connect" in text:
+            print(f"  cannot connect: {first}")
+            print("  -> is Postgres running on that host and port?")
+            return 1
+        elif "password" in text.lower() or "authentication" in text.lower():
+            print(f"  cannot connect: {first}")
+            print("  -> the user/password do not match the server")
+            return 1
+        elif "SSL" in text:
+            print(f"  cannot connect: {first}")
+            print("  -> set DB_SSLMODE=prefer (or disable) for a local server")
+            return 1
+        else:
+            print(f"  cannot connect: {first}")
+            return 1
+        conn = None
+
+    if conn is not None:
+        try:
+            is_local, where = server_is_local(conn)
+        finally:
+            conn.close()
+        if not is_local:
+            if args.check:
+                # --check writes nothing, and "which server am I actually on?"
+                # is exactly what someone runs it to find out.
+                print(f"  note: this server is at {where} — NOT this machine "
+                      "(read-only check, continuing)")
+            elif not args.force:
+                print(f"\n  REFUSING: the server answering is at {where}, which is not "
+                      f"this machine.\n  You asked for host {cfg['host']!r}, but a tunnel, a "
+                      "hosts-file entry or\n  DATABASE_URL can point that at a shared "
+                      "server. This script creates and\n  alters schemas, so it only runs "
+                      "against a local database.\n  Re-run with --force only if you are "
+                      "certain.", file=sys.stderr)
+                return 2
+            else:
+                print(f"  !! --force: proceeding against a NON-LOCAL server at {where}")
+
+    if args.check:
+        if conn is None:
+            return 1
+        with _connect(cfg, cfg["dbname"]) as c:
+            for table in BASE_TABLES + ("sources",):
+                cols = pg_mirror.existing_columns(c, table)
+                print(f"  {table:<24} {'%d columns' % len(cols) if cols else 'MISSING'}")
+            try:
+                pg_mirror.check_schema(c)
+                print("check_schema: OK")
+            except Exception as exc:
+                print(f"check_schema: {exc}")
+                return 1
+        return 0
+
+    created = ensure_database(cfg, cfg["dbname"], force=args.force)
+    print(f"  database {cfg['dbname']}: {'created' if created else 'already exists'}")
+
+    with _connect(cfg, cfg["dbname"]) as conn:
+        is_local, where = server_is_local(conn)
+        if not is_local and not args.force:
+            print(f"  REFUSING: server is at {where}, not this machine.", file=sys.stderr)
+            return 2
+        with conn.cursor() as cur:
+            for table in BASE_TABLES:
+                cur.execute(sql.SQL(BASE_DDL.format(table="{}")).format(sql.Identifier(table)))
+        conn.commit()
+        print("  base tables: ok")
+
+        added = pg_mirror.ensure_schema(conn)
+        for table, cols in added.items():
+            print(f"  {table}: +{len(cols)} hardening columns")
+        pg_mirror.check_schema(conn)
+        print("  check_schema: OK")
+
+        # Same validated connection — never agdb.connect(), which would resolve
+        # its own target and could land on a different server.
+        try:
+            from agent import agdb
+            agdb.ensure_agent_schema(conn)
+            conn.commit()
+            print("  agent_* tables: ok")
+        except Exception as exc:
+            print(f"  agent_* tables: FAILED ({exc})", file=sys.stderr)
+            return 1
+
+    print("\nSchema ready. Next: `streamlit run app.py`")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
