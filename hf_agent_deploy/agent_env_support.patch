+# ---------------------------------------------------------------------------
+# AIM Autonomous Agent — local development environment
+#
+#   1. Copy this file to ".env" IN THIS FOLDER (same folder as app.py).
+#      The name is exactly ".env" — not "env", not ".env.txt".
+#   2. Fill in the <angle bracket> placeholders.
+#   3. Run:  python envfile.py    (masked self-check — no secrets printed)
+#
+# .env is git-ignored. Never commit it, never paste it into chat or email.
+# On Hugging Face these same names are set under
+# Space -> Settings -> Variables and secrets, and always win over this file.
+# ---------------------------------------------------------------------------
+
+# --- Database ---------------------------------------------------------------
+# Local Postgres is the recommended target for development: you get the real
+# schema and none of the risk of writing into the shared RDS instance.
+#
+#   createdb aim_agent            # or: psql -c "CREATE DATABASE aim_agent;"
+#   python migrate.py             # creates/updates the tables
+#
+DB_HOST=localhost
+DB_PORT=5432
+DB_NAME=aim_agent
+DB_USER=postgres
+DB_PASSWORD=<your local postgres password>
+DB_SSLMODE=prefer
+# 'prefer' for localhost. A managed server (RDS) needs 'require'.
+
+# Alternative to the five DB_* lines above — wins if set:
+# DATABASE_URL=postgresql://user:password@host:5432/dbname
+
+# --- Gemini -----------------------------------------------------------------
+# Mint your OWN key: https://aistudio.google.com/apikey  (free tier is enough)
+# API keys are per-person and billable. Do not reuse someone else's, and set a
+# budget cap on yours in the Google Cloud console.
+# Without a key: crawling and the UI work, extraction is disabled.
+GEMINI_API_KEY=<your own Gemini API key>
+# GEMINI_MODEL=gemini-2.5-flash
+
+# --- Agent controls ---------------------------------------------------------
+AGENT_ADMIN_PASSWORD=<pick anything for local use>
+AGENT_AUTOSTART=false      # keep false locally: don't start crawling on boot
+AGENT_INTERVAL_HOURS=6
+AGENT_MAX_PDFS=2           # small caps while testing (Space default: 5)
+AGENT_MAX_PER_QUERY=2
+AGENT_QUERIES_PER_CYCLE=1
+AGENT_WORK_DIR=./agent_work
+
+# --- Optional ---------------------------------------------------------------
+# S2_API_KEY=                      # Semantic Scholar; free tier 429s constantly
+# CONTACT_EMAIL=you@example.com    # polite User-Agent for the crawlers
+# BOOTSTRAP_CLONE_FROM=            # LEAVE EMPTY locally — this clones a schema
+#                                  # from another database on the same server
