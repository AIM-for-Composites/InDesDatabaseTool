@@ -0,0 +1,176 @@
+r"""
+local_bootstrap.py — create an empty local Postgres schema for development.
+
+The Space gets its schema from bootstrap_db.py, which clones the team's live
+database. That needs credentials for the shared RDS instance, which is exactly
+what a laptop should not have. This script builds the same empty schema from
+scratch instead, so a developer can run the whole agent against their own
+Postgres with nothing shared.
+
+What it creates (all IF NOT EXISTS — safe to re-run):
+  1. the target database itself, if missing
+  2. Polymers / Fibers / Composites_materials with the legacy columns the
+     Space's data_loader.py SELECTs
+  3. every hardening column, the dedup indexes and the `sources` table, by
+     calling pg_mirror.ensure_schema() — the same code path pg_migrate.py uses
+  4. the agent_* bookkeeping tables, via agent.agdb.ensure_agent_schema()
+
+Refuses to touch a non-local host unless --force is passed, so a stray
+DB_HOST pointing at RDS cannot be migrated by accident.
+
+Usage:
+    python local_bootstrap.py            # uses .env / environment
+    python local_bootstrap.py --check    # report only, change nothing
+"""
+
+from __future__ import annotations
+
+import argparse
+import os
+import sys
+
+try:
+    import envfile
+    envfile.load_env_file()
+except ImportError:  # pragma: no cover
+    envfile = None
+
+import psycopg
+from psycopg import sql
+
+import pg_mirror
+
+LOCAL_HOSTS = {"localhost", "127.0.0.1", "::1", ""}
+
+BASE_TABLES = ("Polymers", "Fibers", "Composites_materials")
+
+BASE_DDL = """
+CREATE TABLE IF NOT EXISTS {table} (
+    id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
+    material_name text,
+    material_abbreviation text,
+    section text,
+    property_name text,
+    value text,
+    unit text,
+    english text,
+    test_condition text,
+    comments text
+)
+"""
+
+
+def _cfg() -> dict[str, str]:
+    return {
+        "host": os.environ.get("DB_HOST", ""),
+        "port": os.environ.get("DB_PORT", "5432"),
+        "dbname": os.environ.get("DB_NAME", ""),
+        "user": os.environ.get("DB_USER", ""),
+        "password": os.environ.get("DB_PASSWORD", ""),
+        "sslmode": os.environ.get("DB_SSLMODE", "prefer"),
+    }
+
+
+def _connect(dbname: str) -> psycopg.Connection:
+    c = _cfg()
+    return psycopg.connect(host=c["host"] or None, port=int(c["port"]),
+                           dbname=dbname, user=c["user"] or None,
+                           password=c["password"] or None,
+                           sslmode=c["sslmode"], connect_timeout=15)
+
+
+def ensure_database(name: str) -> bool:
+    """CREATE DATABASE if absent. Returns True if it created one."""
+    with _connect("postgres") as conn:
+        conn.autocommit = True
+        with conn.cursor() as cur:
+            cur.execute("SELECT 1 FROM pg_database WHERE datname = %s", (name,))
+            if cur.fetchone():
+                return False
+            cur.execute(sql.SQL("CREATE DATABASE {}").format(sql.Identifier(name)))
+            return True
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__,
+                                 formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--check", action="store_true",
+                    help="report what exists; make no changes")
+    ap.add_argument("--force", action="store_true",
+                    help="allow a non-local DB_HOST (you almost never want this)")
+    args = ap.parse_args()
+
+    cfg = _cfg()
+    missing = [k for k in ("DB_NAME", "DB_USER") if not os.environ.get(k)]
+    if missing and not os.environ.get("DATABASE_URL"):
+        print("Missing " + ", ".join(missing) +
+              ". Copy .env.example to .env and fill it in, then run "
+              "`python envfile.py` to check.", file=sys.stderr)
+        return 2
+
+    host = cfg["host"].lower()
+    if host not in LOCAL_HOSTS and not args.force:
+        print(f"DB_HOST is {cfg['host']!r}, which is not a local server.\n"
+              "This script is for a development database on your own machine. "
+              "Re-run with --force only if you are certain.", file=sys.stderr)
+        return 2
+
+    print(f"Target: {cfg['user']}@{cfg['host'] or 'local socket'}:{cfg['port']}/{cfg['dbname']}")
+
+    if args.check:
+        try:
+            conn_ctx = _connect(cfg["dbname"])
+        except psycopg.OperationalError as exc:
+            first = str(exc).strip().splitlines()[-1]
+            print(f"  cannot connect: {first}")
+            if "does not exist" in str(exc):
+                print("  -> run `python local_bootstrap.py` (no --check) to create it")
+            elif "Connection refused" in str(exc):
+                print("  -> is Postgres running on that host and port?")
+            elif "password" in str(exc).lower():
+                print("  -> DB_USER / DB_PASSWORD in your .env do not match the server")
+            return 1
+        with conn_ctx as conn:
+            for table in BASE_TABLES + ("sources",):
+                cols = pg_mirror.existing_columns(conn, table)
+                print(f"  {table:<24} {'%d columns' % len(cols) if cols else 'MISSING'}")
+            try:
+                pg_mirror.check_schema(conn)
+                print("check_schema: OK")
+            except Exception as exc:
+                print(f"check_schema: {exc}")
+        return 0
+
+    created = ensure_database(cfg["dbname"])
+    print(f"  database {cfg['dbname']}: {'created' if created else 'already exists'}")
+
+    with _connect(cfg["dbname"]) as conn:
+        with conn.cursor() as cur:
+            for table in BASE_TABLES:
+                cur.execute(sql.SQL(BASE_DDL.format(table='{}')).format(sql.Identifier(table)))
+        conn.commit()
+        print("  base tables: ok")
+
+        added = pg_mirror.ensure_schema(conn)
+        for table, cols in added.items():
+            print(f"  {table}: +{len(cols)} hardening columns")
+        pg_mirror.check_schema(conn)
+        print("  check_schema: OK")
+
+    try:
+        from agent import agdb
+        conn = agdb.connect()
+        try:
+            agdb.ensure_agent_schema(conn)
+            print("  agent_* tables: ok")
+        finally:
+            conn.close()
+    except Exception as exc:
+        print(f"  agent_* tables: skipped ({exc})")
+
+    print("\nSchema ready. Next: `streamlit run app.py`")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
