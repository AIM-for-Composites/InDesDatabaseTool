# --- secrets / local ---
.env
.env.local
*.key
*.pem
credentials.json
agent-teams-auth.json
.claude/

# --- python ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# --- node ---
node_modules/

# --- os ---
Thumbs.db
Desktop.ini
.DS_Store

