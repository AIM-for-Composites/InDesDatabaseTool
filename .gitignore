team/**/transcript.jsonl

# --- project-specific ---
# (gitignore only treats '#' as a comment at the START of a line — never
#  put a comment after a pattern, it becomes part of the pattern.)
crawl_out/
# raw per-case extractions (and harvested figure PNGs) from the last `python -m eval`
eval/last_run/
*.sqlite
*.sqlite.bak
run_report.json
review_queue.csv
# regenerable CSV dumps written by pg_migrate.py --apply
pg_backup_*/

# --- key-bearing scrub scripts for the OTHER repos: never commit -----------
# (these contain the raw leaked Gemini keys as filter-repo replacement maps)
cleanup_*.sh
# filled-in credential templates stay out of git
hf_agent_deploy/agent_local_env.txt
# local repo-cleanup audit (documents live credential status)
REPO_CLEANUP.md
